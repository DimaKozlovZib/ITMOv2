FROM qwen3:4b-instruct
# Reduce default context to speed up scheduling/memory pressure
PARAMETER num_ctx 8192
# Optimal chat values (speed/quality balance)
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.15
# Limit max new tokens to avoid long generations
PARAMETER num_predict 512
# Use multiple threads on CPU for faster decode
PARAMETER num_thread 8

