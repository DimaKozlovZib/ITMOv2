{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/itmo-agent",
  "small_model": "openai/itmo-local",
  "provider": {
    "openai": {
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama-local"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO agent 8k (qwen3 4b instruct)",
          "reasoning": false,
          "limit": {
            "context": 8192,
            "output": 1024
          }
        },
        "itmo-local": {
          "name": "ITMO local 4k (qwen3 4b instruct)",
          "reasoning": false,
          "limit": {
            "context": 4096,
            "output": 1024
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "local-guide-b": {
      "description": "Read-only local repository assistant (strict)",
      "mode": "primary",
      "prompt": "{file:./repo-system-strict.txt}",
      "steps": 6,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}

