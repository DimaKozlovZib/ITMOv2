{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/itmo-agent",
  "small_model": "openai/itmo-agent",
  "provider": {
    "openai": {
      "name": "Ollama local",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "think": false,
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "reasoning": false,
          "options": {
            "reasoningEffort": "none"
          },
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "local-guide-b": {
      "description": "Read-only local repository assistant (strict)",
      "mode": "primary",
      "prompt": "{file:./repo-system-strict.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}

